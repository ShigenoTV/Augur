{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Augur",
  "version": "0.1.1",
  "identifier": "com.shigenotv.augur",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Augur",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "Augur Copilot",
        "url": "overlay.html",
        "width": 380,
        "height": 640,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "category": "Game",
    "shortDescription": "Overlay et planificateur pour Path of Exile 2",
    "copyright": "Augur n'est ni affilié à Grinding Gear Games ni approuvé par eux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzMjcyRjU4RjMwOUREMUMKUldRYzNRbnpXQzhuTXpjNGFuWHFyWlBqUmY5c1lxRGlDN1RaYkxSNVBtSDE2QnE1QlljYUxwRlIK",
      "endpoints": [
        "https://github.com/ShigenoTV/Augur/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
